# Travel Agent ¡X Environment Variables
# Copy this file to .env and fill in the values for your setup.
#
# LLM backend priority order:  Ollama ¡ק vLLM ¡ק Gemini (¡ק Claude optional)
# Availability check results are cached 30 s.
# שששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששששש

# ¢w¢w LLM Backends ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w

# Always-on local Qwen via Ollama (1080 Ti, ~6 GB VRAM)
# Health check: GET $OLLAMA_URL/api/tags (timeout 2 s)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# On-demand stronger model via vLLM (lab 4090, manually started)
# Leave VLLM_URL empty to disable.  Start with: make vllm-up
# Health check: GET $VLLM_URL/v1/models (timeout 2 s)
VLLM_URL=
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# Cloud fallback ¡X Google Gemini (free tier available)
# Availability check: GEMINI_API_KEY must be non-empty (no HTTP probe)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional ¡X Anthropic Claude (paid tier)
# Availability check: ANTHROPIC_API_KEY must be non-empty
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# ¢w¢w Observability (Langfuse, local) ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
# Start with: make langfuse   ¡ק   open http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ¢w¢w Google Places API ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
GOOGLE_PLACES_API_KEY=

# ¢w¢w Duffel flight API (reference only; not in main flow) ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
DUFFEL_ACCESS_TOKEN=

# ¢w¢w Server / agent settings ¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w¢w
API_TOKEN=dev-token
SAGA_PERSIST_DIR=~/.travel_agent/saga
APP_TIMEZONE=Asia/Taipei
DEFAULT_LOCALE_CITY=
OFFLINE_MODE=0
