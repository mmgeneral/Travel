# Use v0.7.2: Built on CUDA 12.4, perfectly compatible with your 12.7 driver.
FROM vllm/vllm-openai:v0.7.2

USER root
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Patch Transformers to the absolute latest to support Gemma 4's architecture
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir git+https://github.com/huggingface/transformers.git \
    accelerate>=1.1.0 \
    peft>=0.14.0

# Force the stable V0 engine to avoid the EngineCore V1 crashes
ENV VLLM_USE_V1=0

ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]
