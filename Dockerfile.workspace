# /ssd/mmg/travel/Dockerfile.workspace
FROM node:22-slim

# 1. Install system dependencies
RUN apt-get update && apt-get install -y \
    curl git python3 python3-pip python3-requests make g++ \
    && rm -rf /var/lib/apt/lists/*

# 2. Setup user and environment
RUN useradd -m agent
RUN mkdir -p /home/agent/.local/bin /home/agent/.npm-global && \
    chown -R agent:agent /home/agent

USER agent
RUN npm config set prefix '/home/agent/.npm-global'
ENV PATH="/home/agent/.local/bin:/home/agent/.npm-global/bin:${PATH}"

# 3. Pre-install Python dependencies (the Staff move)
# This ensures agent.py can run immediately
RUN pip3 install --break-system-packages requests openai langgraph

# 4. Install CLIs
RUN npm install -g @google/gemini-cli
RUN curl -fsSL https://claude.ai/install.sh | bash

ENTRYPOINT ["/bin/bash"]
