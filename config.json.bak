  "rms_norm_eps": 1e-06,
  "vocab_size": 262144,
  "max_position_embeddings": 262144,
  "rope_theta": 1000000.0,
  "sliding_window": 1024,
  "bos_token_id": 2,
  "eos_token_id": 1,
  "pad_token_id": 0,
  "hidden_activation": "gelu_pytorch_tanh",
  "hidden_act": "gelu_pytorch_tanh",
  "tie_word_embeddings": true,
  "transformers_version": "4.44.0"
