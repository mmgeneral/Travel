async function useCurrentLocation(){
  const hint=document.getElementById('geo-hint');
  if(!navigator.geolocation){
    hint.textContent='此瀏覽器不支援定位';
    return;
  }
  hint.textContent='定位中...';
  navigator.geolocation.getCurrentPosition(
    (pos)=>{
      const lat=Number(pos.coords.latitude);
      const lng=Number(pos.coords.longitude);
      onboardingProfile.user_lat=lat;
      onboardingProfile.user_lng=lng;
      if(lat>=24.8&&lat<=25.3&&lng>=121.3&&lng<=121.8){
        document.getElementById('trip-city').value='Taipei';
      }else if(lat>=35.4&&lat<=36.0&&lng>=139.4&&lng<=140.1){
        document.getElementById('trip-city').value='Tokyo';
      }
      hint.textContent=`定位成功：${lat.toFixed(4)}, ${lng.toFixed(4)}`;
    },
    (err)=>{
      hint.textContent=`定位失敗：${err.message||'未知錯誤'}`;
    },
    {enableHighAccuracy:true,timeout:10000,maximumAge:300000}
  );
}
async function loadOnboardingProfile(){
  try{
    const res=await fetch(`${API}/profile/onboarding`,{headers:apiHeaders(),signal:AbortSignal.timeout(4000)});
    if(!res.ok){openOnboardingModal();return;}
    const data=await res.json();
    if(!data.profile){openOnboardingModal();return;}
    onboardingProfile=data.profile;
    renderDays();
    await refreshDaySyncBadges();
    await selectDay(1);
  }catch{
    openOnboardingModal();
  }
}
function setHoldLog(msg){
  document.getElementById('hold-log').textContent=msg;
}
async function searchFlightOffer(){
  const origin=document.getElementById('flight-origin').value.trim().toUpperCase()||'TPE';
  const destination=document.getElementById('flight-destination').value.trim().toUpperCase()||'NRT';
  const date=document.getElementById('flight-date').value||new Date().toISOString().slice(0,10);
  setHoldLog('正在搜尋可 hold 票價...');
  try{
    const res=await fetch(`${API}/duffel/search`,{
      method:'POST',
      headers:apiHeaders({'Content-Type':'application/json'}),
      body:JSON.stringify({origin,destination,date}),
    });
    if(!res.ok)throw new Error(`search failed (${res.status})`);
    const data=await res.json();
    document.getElementById('offer-id').value=data.offer_id||'';
    document.getElementById('passenger-id').value=data.passenger_id||'';
    setHoldLog(`找到票價：${origin}→${destination} ${date}\nprice=${data.price||'?'} ${data.currency||''}\noffer_id=${data.offer_id||''}`);
  }catch(e){
    setHoldLog(`搜尋失敗：${e.message}`);
  }
}
async function holdFlight(){
  const offer_id=document.getElementById('offer-id').value.trim();
  const passenger_id=document.getElementById('passenger-id').value.trim();
  if(!offer_id||!passenger_id){setHoldLog('請先搜尋票價，或手動填 offer_id / passenger_id。');return;}
  setHoldLog('正在建立 hold...');
  try{
    const res=await fetch(`${API}/duffel/hold`,{
      method:'POST',
      headers:apiHeaders({'Content-Type':'application/json'}),
      body:JSON.stringify({offer_id,passenger_id}),
    });
    if(!res.ok)throw new Error(`hold failed (${res.status})`);
    const data=await res.json();
    document.getElementById('order-id').value=data.order_id||'';
    setHoldLog(`Hold 成功（約 24 小時）\norder_id=${data.order_id||''}\nidem_key=${data.idem_key||''}`);
  }catch(e){
    setHoldLog(`Hold 失敗：${e.message}`);
  }
}
async function cancelHold(){
  const order_id=document.getElementById('order-id').value.trim();
  if(!order_id){setHoldLog('請先輸入 order_id。');return;}
  setHoldLog(`正在取消 hold：${order_id} ...`);
  try{
    const res=await fetch(`${API}/duffel/orders/${encodeURIComponent(order_id)}`,{
      method:'DELETE',
      headers:apiHeaders(),
    });
    if(!res.ok)throw new Error(`cancel failed (${res.status})`);
    const data=await res.json();
    setHoldLog(`取消完成\noutcome=${data.outcome||''}\nsemantic=${data.semantic_status||''}`);
  }catch(e){
    setHoldLog(`取消失敗：${e.message}`);
  }
}
function confirmPurchase(){
  const order_id=document.getElementById('order-id').value.trim();
  if(!order_id){setHoldLog('請先 hold 一筆訂單。');return;}
  setHoldLog(
    `已記錄要確認購買：${order_id}\n`+
    '目前後端僅開放 hold / cancel。\n'+
    '下一步可加 /duffel/confirm 來做正式出票（capture）。'
  );
}
let recognition=null,recording=false;
function initSpeech(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR)return null;
  const r=new SR();r.continuous=false;r.interimResults=true;r.lang='zh-TW';
  r.onresult=e=>{let t='';for(let i=e.resultIndex;i<e.results.length;i++)t+=e.results[i][0].transcript;document.getElementById('msg').value=t;};
  r.onend=()=>{
    recording=false;
    document.getElementById('mic').classList.remove('rec');
    document.getElementById('mic-label').textContent='語音';
    setStatus('ok','就緒');
    const ta=document.getElementById('msg');
    requestAnimationFrame(()=>{
      ta.focus();
      const len=ta.value.length;
      try{ta.setSelectionRange(len,len);}catch{}
    });
  };
  r.onerror=e=>setStatus('err','語音錯誤：'+e.error);
  return r;
}
function toggleMic(){
  if(!recognition)recognition=initSpeech();
  if(!recognition){setStatus('err','此瀏覽器不支援語音輸入');return;}
  if(recording){recognition.stop();}
  else{recognition.start();recording=true;document.getElementById('mic').classList.add('rec');document.getElementById('mic-label').textContent='停止';setStatus('busy','聆聽中…');}
}
(async()=>{
  if(currentThreadId){
    const pb=document.getElementById('pause-btn');
    if(pb)pb.style.display='';
  }
  if(!document.getElementById('flight-date').value){
    document.getElementById('flight-date').value=new Date(Date.now()+86400000).toISOString().slice(0,10);
  }
  refreshModeUi();
  refreshConversationBanner();
  await loadDietaryProfile();
  await loadOnboardingProfile();
  try{const r=await fetch(`${API}/healthz`,{signal:AbortSignal.timeout(4000)});setStatus(r.ok?'ok':'err',r.ok?'API 已連線':'API 回應異常');}
  catch{setStatus('err','API 離線');}
})();
</script>
