}
async function saveDietary(){
  const profile=normalizeProfile({
    ethics:document.getElementById('diet-ethics').value,
    religious:document.getElementById('diet-religious').value,
    allergens:collectChecked('allergen-chips'),
    medical:collectChecked('medical-chips'),
  });
  try{
    const res=await fetch(`${API}/profile/dietary`,{
      method:'PUT',
      headers:apiHeaders({'Content-Type':'application/json'}),
      body:JSON.stringify(profile),
    });
    if(!res.ok)throw new Error('儲存失敗');
    const data=await res.json();
    dietaryProfile=normalizeProfile(data.dietary_profile||profile);
    localStorage.setItem('dietaryProfile',JSON.stringify(dietaryProfile));
    closeDietaryModal();
    setStatus('ok','已更新飲食限制（雲端）');
  }catch{
    dietaryProfile=profile;
    localStorage.setItem('dietaryProfile',JSON.stringify(dietaryProfile));
    closeDietaryModal();
    setStatus('err','雲端儲存失敗，已暫存本機');
  }
}
