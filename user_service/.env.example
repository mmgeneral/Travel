# Copy to user_service/.env and fill in.
# Never commit real secrets.

USER_SERVICE_APP_NAME=user-service

# Local development (host port 5433 maps to the postgres container).
USER_SERVICE_DATABASE_URL=postgresql+psycopg://user_service:user_service@localhost:5433/user_service

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Leave empty only when USER_SERVICE_DEV_MODE=1 (local tests).
USER_SERVICE_SUPABASE_URL=

# Only for legacy projects that still sign access tokens with HS256.
# New projects use JWKS and should leave this empty.
USER_SERVICE_SUPABASE_JWT_SECRET=

USER_SERVICE_SUPABASE_JWT_AUDIENCE=authenticated

# 0 = production behaviour (default). 1 = accept "Bearer dev:<id>".
# NEVER set to 1 in production.
USER_SERVICE_DEV_MODE=0

# Comma separated origins for the browser app, e.g. http://localhost:5173
USER_SERVICE_CORS_ORIGINS=
